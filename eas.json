{
    "cli": {
        "version": ">= 21.8.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_ENABLE_LOCAL_MODEL": "true",
                "LUMICARE_ANDROID_ARCHS": "x86_64,arm64-v8a"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_ENABLE_LOCAL_MODEL": "true",
                "LUMICARE_ANDROID_ARCHS": "arm64-v8a"
            }
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_ENABLE_LOCAL_MODEL": "true",
                "LUMICARE_ANDROID_ARCHS": "arm64-v8a"
            }
        }
    }
}